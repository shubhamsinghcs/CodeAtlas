{
  "name": "@codeatlas/cli",
  "version": "0.1.0",
  "description": "CodeAtlas CLI - Give your AI coding agent a map before it edits your code.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "codeatlas": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeatlas/codeatlas.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@codeatlas/ai": "workspace:*",
    "@codeatlas/analyzer": "workspace:*",
    "@codeatlas/database": "workspace:*",
    "@codeatlas/mcp": "workspace:*",
    "@codeatlas/risk-engine": "workspace:*",
    "@codeatlas/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  }
}
